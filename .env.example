# ── Required ────────────────────────────────────────────────────────────────
# Postgres. On Vercel use Neon (Storage → Create → Neon); use the *pooled* connection string.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/studycraft
# 32+ random chars. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Public URL of the app, no trailing slash. Optional on Vercel (defaults to the production domain).
APP_URL=http://localhost:5173
